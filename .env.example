# ──────────────────────────────────────────────────────────────
# Bumim — environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# NEVER commit real secrets — `.env*` is ignored by git (except this file).
# ──────────────────────────────────────────────────────────────

# ── Public (safe in the browser — must be prefixed NEXT_PUBLIC_) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon key. The anon key is safe to expose; it is
# restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (NEVER prefix with NEXT_PUBLIC_) ──
# Bypasses Row Level Security. Server-side only (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
