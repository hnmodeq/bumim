# ------------------------------------------------------------------
# BUMIM STUDIO — Environment variables
# Copy this file to `.env` (local) and fill in real values.
# In Vercel, add the same variables under Project > Settings > Environment Variables.
# ------------------------------------------------------------------

# ---- Prisma Postgres / PostgreSQL database --------------------------
# Connection string from Prisma Postgres (or another PostgreSQL provider).
# Required for Prisma migrations, admin edits, and persistent project/pricing data.
DATABASE_URL="postgresql://user:password@db.prisma.io:5432/postgres?sslmode=require"

# ---- Supabase (Storage) --------------------------------------------
# Project URL (https://xxx.supabase.co) and keys from Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="bumim-media"

# ---- NextAuth ------------------------------------------------------
# Generate with: npx auth secret   (or openssl rand -base64 32)
NEXTAUTH_SECRET="change-me-generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"   # set to your production URL in Vercel

# Google OAuth (optional). If you only use the password login, you can leave these blank.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" to show the "Sign in with Google" button on the admin login page.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN="false"

# ---- Admin ---------------------------------------------------------
# Simple password login fallback (used by the Credentials provider).
# Choose a strong password; store in Vercel env for production.
ADMIN_PASSWORD="change-me-admin-password"

# Comma-separated list of admin emails (Google login) — optional.
ADMIN_EMAILS="you@gmail.com"
